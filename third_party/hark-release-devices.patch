+// HARK PATCH: release devices
+// The cache and buffer_type.context pin every device; drop them when nothing else holds it.
+int ggml_backend_vk_release_devices(void) {
+    if (!vk_instance_initialized) {
+        return 0;
+    }
+    int released = 0;
+    for (size_t idx = 0; idx < GGML_VK_MAX_DEVICES; idx++) {
+        vk_device & dev = vk_instance.devices[idx];
+        if (dev == nullptr) {
+            continue;
+        }
+        long expected = 2;  // cache + buffer_type.context
+        {
+            std::lock_guard<std::recursive_mutex> guard(dev->mutex);
+            if (!dev->pinned_memory.empty()) {
+                continue;
+            }
+        }
+        if (dev->sync_staging != nullptr) {
+            if (dev->sync_staging.use_count() != 1) {
+                continue;
+            }
+            expected++;  // sync_staging->device
+        }
+        if (dev.use_count() != expected) {
+            continue;
+        }
+        dev->device.waitIdle();
+        ggml_vk_destroy_buffer(dev->sync_staging);
+        delete (ggml_backend_vk_buffer_type_context *) dev->buffer_type.context;
+        dev->buffer_type.context = nullptr;
+        vk_device_ref weak = dev;
+        dev.reset();
+        if (weak.expired()) {
+            released++;
+        } else {
+            GGML_LOG_WARN("ggml_vulkan: device %zu still referenced after release\n", idx);
+        }
+    }
+    return released;
+}
+
 bool ggml_backend_is_vk(ggml_backend_t backend) {
